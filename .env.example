# Copiar a `.env.local` en desarrollo.
# En Vercel: Project → Settings → Environment Variables (Production / Preview / Development).

# Obligatorias — cliente Supabase (NEXT_PUBLIC_* se exponen al navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional — URL base para enlaces de auth / redirects (ej. magic link callback).
# Si no está definida, la app puede usar un fallback; en producción conviene fijarla al dominio de Vercel.
# NEXT_PUBLIC_SITE_URL=https://tu-proyecto.vercel.app

# Solo scripts locales (`scripts/*.ts`) — nunca NEXT_PUBLIC; no subir la service role al cliente.
# SUPABASE_SERVICE_ROLE_KEY=
